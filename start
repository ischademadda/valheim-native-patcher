#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

ACTION="$1"
shift || true

case "$ACTION" in
    patch)
        "$SCRIPT_DIR/patch.sh" "$@"
        ;;
    status)
        "$SCRIPT_DIR/patch.sh" --status "$@"
        ;;
    verify)
        "$SCRIPT_DIR/patch.sh" --verify "$@"
        ;;
    restore)
        "$SCRIPT_DIR/patch.sh" --restore "$@"
        ;;
    dist)
        "$SCRIPT_DIR/make-dist.sh"
        ;;
    ensure)
        "$SCRIPT_DIR/autopatch.sh"
        tail -n 5 "$SCRIPT_DIR/autopatch.log"
        ;;
    v5|v6|v7|v8|v9)
        "$SCRIPT_DIR/patch.sh" "$ACTION" "$@"
        ;;
    help|--help|-h|"")
        echo "========================================================="
        echo "     Valheim Native IL Patcher Runner                    "
        echo "========================================================="
        echo "Usage:"
        echo "  ./start patch v9       Apply patch v9 (Recommended: v7 + vanilla-correct support/fire, fast terrain cooking)"
        echo "  ./start patch v8       Apply patch v8 (Zero-Stutter Anti-Pattern Elimination)"
        echo "  ./start patch v7       Apply patch v7 (Stable Engine, Physics & Combat Fixes)"
        echo "  ./start patch v6       Apply patch v6 (Legacy Stable)"
        echo "  ./start patch v5       Apply patch v5 (Legacy Optimization)"
        echo "  ./start patch status   Check current patch marker & status"
        echo "  ./start patch verify   Verify patch integrity in assembly"
        echo "  ./start patch restore  Restore original vanilla assembly"
        echo "  ./start dist           Build dist/ValheimPatcher-win-x64.zip for Windows friends"
        echo "  ./start ensure         Re-apply v9 only if missing (same check Steam runs via autopatch.sh)"
        echo ""
        echo "Direct shortcuts also supported:"
        echo "  ./start v9             Same as './start patch v9'"
        echo "  ./start v8             Same as './start patch v8'"
        echo "  ./start v7             Same as './start patch v7'"
        echo "  ./start v6             Same as './start patch v6'"
        echo "  ./start v5             Same as './start patch v5'"
        echo "  ./start status         Same as './start patch status'"
        echo "  ./start verify         Same as './start patch verify'"
        echo "  ./start restore        Same as './start patch restore'"
        echo "========================================================="
        ;;
    *)
        echo "[ERROR] Unknown command: '$ACTION'"
        echo "Run './start help' to see available commands."
        exit 1
        ;;
esac
