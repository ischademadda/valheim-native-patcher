<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <!-- Profiler helper: built first, then embedded so a single-file patcher can drop it into the game's Managed folder -->
  <ItemGroup>
    <ProjectReference Include="../NativeProfiler/NativeProfiler.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile;EnableCompressionInSingleFile" />
    <EmbeddedResource Include="../NativeProfiler/bin/$(Configuration)/netstandard2.1/NativePatchProfiler.dll" LogicalName="NativePatchProfiler.dll" />
  </ItemGroup>

  <!-- Mistlands fog logic (v9.8): same embedding scheme, always shipped with the v9 patch -->
  <ItemGroup>
    <ProjectReference Include="../NativeMist/NativeMist.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile;EnableCompressionInSingleFile" />
    <EmbeddedResource Include="../NativeMist/bin/$(Configuration)/netstandard2.1/NativePatchMist.dll" LogicalName="NativePatchMist.dll" />
  </ItemGroup>

</Project>
